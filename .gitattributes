# Нормализация переводов строк: в репозитории LF
* text=auto eol=lf

# Текстовые файлы
*.php text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.conf text eol=lf
*.vue text eol=lf
*.sql text eol=lf

*.sh text eol=lf

# Windows-скрипты
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Бинарные файлы
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary

# Lock-файлы
composer.lock text eol=lf
package-lock.json text eol=lf
