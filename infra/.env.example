# ============================================================
# Инфраструктура (dev): читается ТОЛЬКО docker compose.
# Секреты и порты платформы. Laravel этот файл не видит.
# Скопируйте в .env:  cp .env.example .env
# ============================================================

# ---- Версии образов ----
PHP_VERSION=8.5
NODE_VERSION=22

# ---- Порты, публикуемые на хост ----
# На хосте нативный PostgreSQL 17 занимает 5432, поэтому контейнерная БД
# публикуется на 5433. Внутри docker-сети сервисы ходят на pg:5432.
APP_PORT=8000
POSTGRES_PORT=5433
ADMINER_PORT=8080
MAILPIT_PORT=8025
# Kafka для хоста (EXTERNAL listener). Внутри docker-сети брокер — kafka:9092.
KAFKA_PORT=9094
# Порты фронтендов: по одному на приложение (см. frontend/).
# Внутри контейнера Vite всегда слушает 5173 — наружу уходит на свой порт.
PORTFOLIO_PORT=5173

# ---- Учётные данные PostgreSQL (контейнер pg) ----
# ⚠️ Должны совпадать с DB_USERNAME/DB_PASSWORD/DB_DATABASE в
# services/core/.env. Проверка: .\dev.ps1 env-check
POSTGRES_DB=api
POSTGRES_USER=api
POSTGRES_PASSWORD=secret

# ---- Отладка Xdebug: off | debug | develop | coverage ----
XDEBUG_MODE=off
