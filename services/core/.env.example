# ============================================================
# Сервис core (Laravel). Читается ТОЛЬКО приложением.
# Инфраструктурные переменные (порты, POSTGRES_*) — в infra/.env
# Скопируйте в .env:  cp .env.example .env
# ============================================================

# ---- Приложение (Laravel) ----
APP_NAME="II API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---- База данных ----
# ⚠️ Должно совпадать с POSTGRES_* в infra/.env.
# Проверка: .\dev.ps1 env-check
DB_CONNECTION=pgsql
DB_HOST=pg
DB_PORT=5432
DB_DATABASE=api
DB_USERNAME=api
DB_PASSWORD=secret

# ---- Redis: кэш, очереди, токены ----
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Очереди и кэш ----
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Для чистого API сессия не нужна (используем токены)
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ---- Логи ----
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Почта: Mailpit перехватывает всё, UI на :8025 ----
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

VITE_APP_NAME="${APP_NAME}"
