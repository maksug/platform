# ============================================================
# Шаблон тестового окружения (APP_ENV=testing)
# Скопируйте в .env.testing и сгенерируйте ключ:
#   cp .env.testing.example .env.testing
#   php artisan key:generate --env=testing
# ============================================================

APP_NAME="Foundation API"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- База: отдельная БД, чтобы RefreshDatabase не трогал dev-данные ----
DB_CONNECTION=pgsql
DB_HOST=pg
DB_PORT=5432
DB_DATABASE=api_test
DB_USERNAME=api
DB_PASSWORD=secret

# ---- Детерминизм тестов ----
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
